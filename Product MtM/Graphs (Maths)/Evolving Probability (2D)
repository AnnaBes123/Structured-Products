import numpy as np
import pandas as pd
import matplotlib.pyplot as plt
import matplotlib.animation as animation
from scipy.stats import norm, multivariate_normal

# ---------------------------------------------------------------------------
# 2D evolving probability: P2(t) = P(S_t1 <= K1, S_t2 <= K2), with
# t1 = 2025-06-30 (end of Q2), t2 = 2025-09-30 (end of Q3), recomputed every
# trading day t from Jan 2025 up to t1, using that day's REAL S&P 500 spot
# and REAL implied vol (interpolated to T1). Shows the actual BIVARIATE
# lognormal density of (S_t1, S_t2) as a contour, reshaping day by day, with
# the region {S_t1<=K1, S_t2<=K2} highlighted - that highlighted probability
# mass IS P2(t).
#
# Under risk-neutral GBM, (y1,y2) = (ln S_t1, ln S_t2) is jointly normal:
#   mean = [ln S_t + v*T1, ln S_t + v*T2],  v = mu - 0.5*sigma_t^2
#   var(y1) = sigma_t^2*T1, var(y2) = sigma_t^2*T2
#   cov(y1,y2) = sigma_t^2*min(T1,T2) = sigma_t^2*T1   (T1 < T2 always here,
#     since increments of Brownian motion over non-overlapping periods are
#     independent, so the covariance of the two CUMULATIVE log-changes from
#     "now" is exactly the variance of their shared/overlapping stretch, T1)
# so corr(y1,y2) = sqrt(T1/T2), and
#   P2(t) = Phi2(d1, d2; rho12),  d_i = (ln Ki - ln S_t - v*Ti)/(sigma_t*sqrt(Ti))
# ---------------------------------------------------------------------------

ENTRY_DATE = "2025-01-02"
OBS_DATE_1 = "2025-06-30"  # t1: end of Q2
OBS_DATE_2 = "2025-09-30"  # t2: end of Q3
K1_PCT = 1.00
K2_PCT = 1.00
MU = 0.04

TICKER = "^GSPC"
FRED_SERIES = "SP500"
VOL_TERM_STRUCTURE_TICKERS = {"^VIX": 30, "^VIX3M": 93, "^VIX6M": 182}
VIX_FRED_SERIES = "VIXCLS"


def fetch_daily_closes(ticker, start, end, fred_series=None):
    series = None
    try:
        import yfinance as yf
        data = yf.download(ticker, start=start, end=end, progress=False, auto_adjust=False)
        if data is not None and not data.empty:
            close = data["Close"]
            if isinstance(close, pd.DataFrame):
                close = close.iloc[:, 0]
            series = close.dropna()
    except Exception as exc:
        print(f"  yfinance failed for {ticker} ({exc})" + (" ; trying FRED fallback..." if fred_series else ""))

    if (series is None or series.empty) and fred_series:
        try:
            import pandas_datareader.data as web
            data = web.DataReader(fred_series, "fred", start, end)
            series = data[fred_series].dropna()
        except Exception as exc:
            raise RuntimeError(f"Could not fetch {ticker} data from either yfinance or FRED: {exc}")

    if series is None or series.empty:
        raise RuntimeError(f"No data returned for {ticker}")
    return series


def interpolate_implied_vol(vols_by_tenor, T_years):
    points = sorted(vols_by_tenor.items())
    if T_years <= points[0][0]:
        return points[0][1]
    if T_years >= points[-1][0]:
        return points[-1][1]
    for (t0, v0), (t1, v1) in zip(points, points[1:]):
        if t0 <= T_years <= t1:
            var0, var1 = v0 ** 2 * t0, v1 ** 2 * t1
            var_T = var0 + (var1 - var0) * (T_years - t0) / (t1 - t0)
            return np.sqrt(var_T / T_years)
    return points[-1][1]


def d_barrier(S_t, K, T, sigma_t, mu):
    v = mu - 0.5 * sigma_t ** 2
    return (np.log(K / S_t) - v * T) / (sigma_t * np.sqrt(T))


def bivariate_lognormal_density(S1_grid, S2_grid, S_t, T1, T2, sigma_t, mu):
    """f_S(s1,s2) = f_Y(ln s1, ln s2) / (s1*s2) - Jacobian of the log transform."""
    v = mu - 0.5 * sigma_t ** 2
    mean = [np.log(S_t) + v * T1, np.log(S_t) + v * T2]
    cov = [[sigma_t ** 2 * T1, sigma_t ** 2 * T1],
           [sigma_t ** 2 * T1, sigma_t ** 2 * T2]]
    rv = multivariate_normal(mean=mean, cov=cov)

    S1, S2 = np.meshgrid(S1_grid, S2_grid)
    Y = np.stack([np.log(S1), np.log(S2)], axis=-1)
    return rv.pdf(Y) / (S1 * S2)


print(f"Fetching S&P 500 path from {ENTRY_DATE} to {OBS_DATE_1}...")
close = fetch_daily_closes(TICKER, ENTRY_DATE, OBS_DATE_1, fred_series=FRED_SERIES)
close = close[close.index < pd.Timestamp(OBS_DATE_1)]  # stop the day before t1 (T1 must stay > 0)
S0 = float(close.iloc[0])
K1, K2 = K1_PCT * S0, K2_PCT * S0

print("Fetching VIX / VIX3M / VIX6M term structure for the same window...")
vol_term_structure = {}
for ticker, tenor_days in VOL_TERM_STRUCTURE_TICKERS.items():
    fred_series = VIX_FRED_SERIES if ticker == "^VIX" else None
    series = fetch_daily_closes(ticker, ENTRY_DATE, OBS_DATE_1, fred_series=fred_series)
    vol_term_structure[tenor_days / 365.25] = (series / 100.0).reindex(close.index).ffill().bfill()

t1_date, t2_date = pd.Timestamp(OBS_DATE_1), pd.Timestamp(OBS_DATE_2)
dates = close.index
T1_years = np.array([(t1_date - d).days / 365.25 for d in dates])
T2_years = np.array([(t2_date - d).days / 365.25 for d in dates])
sigma_t_series = np.array([
    interpolate_implied_vol({tenor: s.loc[d] for tenor, s in vol_term_structure.items()}, T1_years[i])
    for i, d in enumerate(dates)
])
S_t_series = close.values

d1_series = d_barrier(S_t_series, K1, T1_years, sigma_t_series, MU)
d2_series = d_barrier(S_t_series, K2, T2_years, sigma_t_series, MU)
rho12_series = np.sqrt(T1_years / T2_years)
P2_series = np.array([
    multivariate_normal(mean=[0, 0], cov=[[1, rho12_series[i]], [rho12_series[i], 1]]).cdf(
        [d1_series[i], d2_series[i]])
    for i in range(len(dates))
])

s1_grid = np.linspace(0.4 * S0, 1.7 * S0, 140)
s2_grid = np.linspace(0.4 * S0, 1.7 * S0, 140)
S1_mesh, S2_mesh = np.meshgrid(s1_grid, s2_grid)

fig, ax = plt.subplots(figsize=(9, 8.5))
ax.set_xlim(s1_grid[0], s1_grid[-1])
ax.set_ylim(s2_grid[0], s2_grid[-1])
ax.set_xlabel("S_t1 (index level, 2025-06-30)")
ax.set_ylabel("S_t2 (index level, 2025-09-30)")
ax.axvline(K1, color="dodgerblue", linewidth=1.0, linestyle="dotted")
ax.axhline(K2, color="dodgerblue", linewidth=1.0, linestyle="dotted")
ax.text(K1, s2_grid[0], f" K1={K1_PCT:.0%} of S0", color="dodgerblue", rotation=90, va="bottom", fontsize=8)
ax.text(s1_grid[0], K2, f" K2={K2_PCT:.0%} of S0", color="dodgerblue", va="bottom", fontsize=8)
ax.fill_between([s1_grid[0], K1], s2_grid[0], K2, color="dodgerblue", alpha=0.08, zorder=0)
title = ax.set_title("")

contour_artists = []


def update(frame):
    global contour_artists
    for artist in contour_artists:
        artist.remove()
    contour_artists = []

    S_t, T1, T2, sigma_t, P2, date = (S_t_series[frame], T1_years[frame], T2_years[frame],
                                       sigma_t_series[frame], P2_series[frame], dates[frame])
    density = bivariate_lognormal_density(s1_grid, s2_grid, S_t, T1, T2, sigma_t, MU)

    cs = ax.contourf(S1_mesh, S2_mesh, density, levels=15, cmap="Reds", alpha=0.85, zorder=1)
    contour_artists.extend(cs.collections if hasattr(cs, "collections") else [cs])
    spot_pt = ax.scatter([S_t], [S_t], color="black", zorder=5, s=25)
    contour_artists.append(spot_pt)

    title.set_text(
        f"{date.date()}  |  S_t = {S_t:,.0f}   sigma_t = {sigma_t:.1%}   "
        f"T1 = {T1*365:.0f}d  T2 = {T2*365:.0f}d\n"
        f"P(S_t1 <= K1, S_t2 <= K2) = {P2:.2%}   (mass inside dotted box)"
    )
    return contour_artists + [title]


anim = animation.FuncAnimation(fig, update, frames=len(dates), interval=80, blit=False)

OUTPUT_GIF = __file__ + ".gif"
print(f"Rendering {len(dates)} frames to {OUTPUT_GIF} ...")
anim.save(OUTPUT_GIF, writer=animation.PillowWriter(fps=12))
print("Done.")

plt.show()
